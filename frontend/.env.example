# Copy to frontend/.env.local. Everything here is PUBLIC (shipped to the browser) - never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cloudflare Turnstile site key (optional locally). Pairs with TURNSTILE_SECRET_KEY on the backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_REPO_URL=https://github.com/aurimas13/Claude-Agent-From-Scratch
