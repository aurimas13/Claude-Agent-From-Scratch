# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: only if your key needs an explicit workspace
ANTHROPIC_WORKSPACE_ID=
MODEL=claude-sonnet-5

# --- Supabase (optional locally: without it the app uses in-memory storage) ---
# Project Settings -> API Keys -> "Secret keys" (sb_secret_...). Server-side only!
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=

# --- Production hardening (Railway) ---
ENVIRONMENT=development
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# Cloudflare Turnstile secret (pairs with NEXT_PUBLIC_TURNSTILE_SITE_KEY in the frontend)
TURNSTILE_SECRET_KEY=
# Random string used to hash visitor IPs. Generate: python -c "import secrets;print(secrets.token_hex(32))"
IP_HASH_SALT=

# --- Limits (defaults shown) ---
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
DAILY_BUDGET_USD=3.0
MAX_MESSAGE_CHARS=1500
MAX_TURNS_PER_CONVERSATION=30
WEB_SEARCH_MAX_USES=3
